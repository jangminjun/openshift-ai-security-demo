# Demo defaults. No secrets here -- cluster URL/credentials go in local.env
# (gitignored, see local.env.example). Every value can be overridden from the
# environment, e.g. DEMO_NAMESPACE=foo ./harness.sh scenario1-prep

DEMO_NAMESPACE="${DEMO_NAMESPACE:-security-demo}"
DEMO_DISPLAY_NAME="${DEMO_DISPLAY_NAME:-Security Demo}"

DSC_NAME="${DSC_NAME:-default-dsc}"
RHOAI_OPERATOR_NAMESPACE="${RHOAI_OPERATOR_NAMESPACE:-redhat-ods-operator}"
RHOAI_APPS_NAMESPACE="${RHOAI_APPS_NAMESPACE:-redhat-ods-applications}"

# Scenario 1 -- custom RBAC role UI
# Roles are looked up by metadata.name first, then by the display name typed
# into the Dashboard form (<name>-custom).
MAINTAINER_ROLE="${MAINTAINER_ROLE:-workbench-maintainer}"
READER_ROLE="${READER_ROLE:-workbench-reader}"
# Non-admin demo users. USER_NONE gets no role at all, to show the project is
# invisible without one. The harness only binds roles to these names; the
# login accounts themselves must exist in the cluster's identity provider.
USER_MAINTAINER="${USER_MAINTAINER:-wb-maintainer}"
USER_READER="${USER_READER:-wb-reader}"
USER_NONE="${USER_NONE:-wb-none}"

# Scenario 2 -- existing Secret as workbench env var
SECRET_NAME="${SECRET_NAME:-external-db-credentials}"
WORKBENCH_NAME="${WORKBENCH_NAME:-secret-demo-wb}"

# Scenarios 4/6 -- garak scan results in the Red Hat AI model catalog
CATALOG_NAMESPACE="${CATALOG_NAMESPACE:-rhoai-model-registries}"
CATALOG_ROUTE="${CATALOG_ROUTE:-model-catalog-https}"
CATALOG_MODEL="${CATALOG_MODEL:-RedHatAI/gemma-4-12B-it-FP8-Dynamic}"

# Scenario 5 -- automated red teaming (EvalHub + garak). Everything lives in
# its own project so scenario5-stop can remove it by deleting the namespace.
REDTEAM_NAMESPACE="${REDTEAM_NAMESPACE:-redteam-demo}"
REDTEAM_MODEL="${REDTEAM_MODEL:-redteam-target}"
REDTEAM_S3_SECRET="${REDTEAM_S3_SECRET:-redteam-s3}"
REDTEAM_AUTH_SECRET="${REDTEAM_AUTH_SECRET:-redteam-model-auth}"
# Seconds to wait for a scan before giving up watching it (the job keeps running).
REDTEAM_TIMEOUT="${REDTEAM_TIMEOUT:-3600}"

# Scenario 3 -- OAuth proxy resources via the DataScienceCluster API
ISVC_NAMESPACE="${ISVC_NAMESPACE:-${DEMO_NAMESPACE}}"
ISVC_NAME="${ISVC_NAME:-demo-model}"
