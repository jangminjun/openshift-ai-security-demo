# Demo defaults. No secrets here -- cluster URL/credentials go in local.env
# (gitignored, see local.env.example). Every value can be overridden from the
# environment, e.g. DEMO_NAMESPACE=foo ./harness.sh scenario1-prep

DEMO_NAMESPACE="${DEMO_NAMESPACE:-security-demo}"
DEMO_DISPLAY_NAME="${DEMO_DISPLAY_NAME:-Security Demo}"

DSC_NAME="${DSC_NAME:-default-dsc}"
RHOAI_OPERATOR_NAMESPACE="${RHOAI_OPERATOR_NAMESPACE:-redhat-ods-operator}"
RHOAI_APPS_NAMESPACE="${RHOAI_APPS_NAMESPACE:-redhat-ods-applications}"

# Scenario 1 -- custom RBAC role UI
# Roles are looked up by metadata.name first, then by the display name typed
# into the Dashboard form (<name>-custom).
MAINTAINER_ROLE="${MAINTAINER_ROLE:-workbench-maintainer}"
READER_ROLE="${READER_ROLE:-workbench-reader}"
# Non-admin demo users. USER_NONE gets no role at all, to show the project is
# invisible without one. The harness only binds roles to these names; the
# login accounts themselves must exist in the cluster's identity provider.
USER_MAINTAINER="${USER_MAINTAINER:-wb-maintainer}"
USER_READER="${USER_READER:-wb-reader}"
USER_NONE="${USER_NONE:-wb-none}"

# Scenario 2 -- existing Secret as workbench env var
SECRET_NAME="${SECRET_NAME:-external-db-credentials}"
WORKBENCH_NAME="${WORKBENCH_NAME:-secret-demo-wb}"

# Scenarios 4/6 -- garak scan results in the Red Hat AI model catalog
CATALOG_NAMESPACE="${CATALOG_NAMESPACE:-rhoai-model-registries}"
CATALOG_ROUTE="${CATALOG_ROUTE:-model-catalog-https}"
CATALOG_MODEL="${CATALOG_MODEL:-RedHatAI/gemma-4-12B-it-FP8-Dynamic}"

# Scenario 5 -- automated red teaming (EvalHub + garak). Everything lives in
# its own project so scenario5-stop can remove it by deleting the namespace.
REDTEAM_NAMESPACE="${REDTEAM_NAMESPACE:-redteam-demo}"
REDTEAM_MODEL="${REDTEAM_MODEL:-redteam-target}"
REDTEAM_S3_SECRET="${REDTEAM_S3_SECRET:-redteam-s3}"
REDTEAM_AUTH_SECRET="${REDTEAM_AUTH_SECRET:-redteam-model-auth}"
# Seconds to wait for a scan before giving up watching it (the job keeps running).
REDTEAM_TIMEOUT="${REDTEAM_TIMEOUT:-3600}"
# Upper limit garak itself gets for scans with a custom probe list.
REDTEAM_SCAN_TIMEOUT="${REDTEAM_SCAN_TIMEOUT:-3600}"

# Scenario 7 -- model security check: every candidate gets the same probes.
# Chosen to cover OWASP LLM risks while being scored by garak's own
# detectors rather than an LLM judge: jailbreak, prompt injection, indirect
# injection, encoding evasion, malware generation, product-key leakage,
# markdown data exfiltration, SQL injection echo.
REDTEAM_STANDARD_PROBES="${REDTEAM_STANDARD_PROBES:-dan.Dan_11_0,promptinject.HijackHateHumans,latentinjection.LatentInjectionReport,encoding.InjectBase64,malwaregen.TopLevel,grandma.Win10,web_injection.MarkdownImageExfil,exploitation.SQLInjectionEcho}"
# Prompts per probe; the 256-prompt probes are cut to this many.
REDTEAM_STANDARD_CAP="${REDTEAM_STANDARD_CAP:-40}"

# Scenario 8 -- use-case profiles: a different exam per deployment type.
# All scored by garak's own detectors (some are small classifier models the
# pipeline pod downloads from Hugging Face, so the cluster needs egress).
# Coding assistant: invented packages (supply-chain "slopsquatting"),
# malware that evades AV, template code-execution payloads, XSS in output.
REDTEAM_PROFILE_CODING="${REDTEAM_PROFILE_CODING:-packagehallucination.Python,packagehallucination.JavaScript,malwaregen.Evasion,exploitation.JinjaTemplatePythonInjection,web_injection.TaskXSS}"
# Customer-facing chatbot: system prompt leakage, hijacking, harmful or
# toxic content, going along with false claims, made-up facts.
REDTEAM_PROFILE_CHATBOT="${REDTEAM_PROFILE_CHATBOT:-sysprompt_extraction.SystemPromptExtraction,promptinject.HijackHateHumans,dan.Dan_11_0,lmrc.Bullying,lmrc.QuackMedicine,realtoxicityprompts.RTPBlank,misleading.FalseAssertion,goodside.WhoIsRiley}"
# RAG / agent: instructions hidden in retrieved documents, data exfiltration
# through rendered markdown, training-data regurgitation.
REDTEAM_PROFILE_RAG="${REDTEAM_PROFILE_RAG:-latentinjection.LatentInjectionResume,latentinjection.LatentWhois,latentinjection.LatentInjectionFactSnippetLegal,web_injection.MarkdownURIImageExfilExtended,web_injection.StringAssemblyDataExfil,divergence.Repeat}"
REDTEAM_PROFILE_EXPERIMENT="${REDTEAM_PROFILE_EXPERIMENT:-use-case-profiles}"

# Scenario 10 -- check history in MLflow + scheduled re-checks.
MLFLOW_URL="${MLFLOW_URL:-https://mlflow.redhat-ods-applications.svc:8443/mlflow}"
# MLflow experiment that scenario7-scan and the scheduled check write to.
REDTEAM_CHECK_EXPERIMENT="${REDTEAM_CHECK_EXPERIMENT:-model-security-checks}"
# Cron schedule for the re-check (UTC). Default: Mondays 02:00.
REDTEAM_SCHEDULE="${REDTEAM_SCHEDULE:-0 2 * * 1}"

# Scenario 3 -- OAuth proxy resources via the DataScienceCluster API
ISVC_NAMESPACE="${ISVC_NAMESPACE:-${DEMO_NAMESPACE}}"
ISVC_NAME="${ISVC_NAME:-demo-model}"
